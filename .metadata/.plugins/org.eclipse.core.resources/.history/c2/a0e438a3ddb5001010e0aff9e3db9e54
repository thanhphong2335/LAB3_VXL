int mode = 1;  // Chế độ mặc định là Mode 1
int blink_flag = 0;  // Biến điều khiển nháy LED

// Thời gian cho các đèn
int time_red = 30;  // Đèn đỏ, ví dụ 30 giây
int time_yellow = 5;  // Đèn vàng, ví dụ 5 giây
int time_green = 30;  // Đèn xanh, ví dụ 30 giây

void fsm_traffic_light(void) {
    // Cập nhật giá trị blink_flag (để nháy LED)
    if (blink_flag) {
        blink_flag = 0;  // Đảo trạng thái nháy LED
    }

    switch(mode) {
        case 1:  // Mode 1: Chạy bình thường (đếm ngược thời gian)
            // Đèn giao thông sẽ hoạt động bình thường, đếm ngược thời gian
            if (time_red > 0) {
                time_red--;
                HAL_GPIO_WritePin(LED_RED_B_GPIO_Port, LED_RED_B_Pin, GPIO_PIN_RESET);  // Đèn đỏ sáng (Active Low)
                HAL_GPIO_WritePin(LED_YELLOW_B_GPIO_Port, LED_YELLOW_B_Pin, GPIO_PIN_SET);  // Đèn vàng tắt
                HAL_GPIO_WritePin(LED_GREEN_B_GPIO_Port, LED_GREEN_B_Pin, GPIO_PIN_SET);  // Đèn xanh tắt
            } else if (time_yellow > 0) {
                time_yellow--;
                HAL_GPIO_WritePin(LED_RED_B_GPIO_Port, LED_RED_B_Pin, GPIO_PIN_SET);  // Đèn đỏ tắt
                HAL_GPIO_WritePin(LED_YELLOW_B_GPIO_Port, LED_YELLOW_B_Pin, GPIO_PIN_RESET);  // Đèn vàng sáng (Active Low)
                HAL_GPIO_WritePin(LED_GREEN_B_GPIO_Port, LED_GREEN_B_Pin, GPIO_PIN_SET);  // Đèn xanh tắt
            } else if (time_green > 0) {
                time_green--;
                HAL_GPIO_WritePin(LED_RED_B_GPIO_Port, LED_RED_B_GPIO_Pin, GPIO_PIN_SET);  // Đèn đỏ tắt
                HAL_GPIO_WritePin(LED_YELLOW_B_GPIO_Port, LED_YELLOW_B_Pin, GPIO_PIN_SET);  // Đèn vàng tắt
                HAL_GPIO_WritePin(LED_GREEN_B_GPIO_Port, LED_GREEN_B_Pin, GPIO_PIN_RESET);  // Đèn xanh sáng (Active Low)
            }

            // Hiển thị thời gian còn lại trên LED 7-segment
            led_buffer[0] = (time_red / 10) % 10;  // Hiển thị thời gian cho đèn đỏ
            led_buffer[1] = time_red % 10;
            led_buffer[2] = (time_yellow / 10) % 10;  // Hiển thị thời gian cho đèn vàng
            led_buffer[3] = time_yellow % 10;

            // Cập nhật LED 7-segment
            update7SEG(0);  // Đường A
            update7SEG(1);  // Đường B

            // Chuyển sang Mode 2 khi nút MODE (button 0) nhấn
            if (isbuttonpressed(0) || isbuttonlongpressed(0)) {
                mode = 2;  // Chuyển sang chế độ chỉnh sửa thời gian cho đèn đỏ (Mode 2)
            }
            break;

        case 2:  // Mode 2: Chỉnh thời gian cho đèn đỏ
            // Nháy LED đỏ
            if (blink_flag) {
                HAL_GPIO_TogglePin(LED_RED_B_GPIO_Port, LED_RED_B_Pin);  // Nháy LED đỏ
            } else {
                HAL_GPIO_WritePin(LED_RED_B_GPIO_Port, LED_RED_B_Pin, GPIO_PIN_RESET);  // Đèn đỏ sáng (Active Low)
            }

            // Hiển thị chế độ "02" trên LED 7-segment (đường A)
            led_buffer[0] = 0;  // "0"
            led_buffer[1] = 2;  // "2"
            display7SEG(led_buffer[0]);  // Hiển thị "0" trên LED 7-segment

            // Hiển thị thời gian còn lại cho đèn đỏ
            led_buffer[2] = (time_red / 10) % 10;  // Hiển thị thời gian cho đèn đỏ
            led_buffer[3] = time_red % 10;

            // Cập nhật LED 7-segment
            update7SEG(0);  // Đường A
            update7SEG(1);  // Đường B

            // Chuyển sang Mode 3 khi nút MODE (button 0) nhấn
            if (isbuttonpressed(0) || isbuttonlongpressed(0)) {
                mode = 3;  // Chuyển sang chế độ chỉnh sửa thời gian cho đèn vàng (Mode 3)
            }
            break;

        case 3:  // Mode 3: Chỉnh thời gian cho đèn vàng
            // Nháy LED vàng
            if (blink_flag) {
                HAL_GPIO_TogglePin(LED_YELLOW_B_GPIO_Port, LED_YELLOW_B_Pin);  // Nháy LED vàng
            } else {
                HAL_GPIO_WritePin(LED_YELLOW_B_GPIO_Port, LED_YELLOW_B_Pin, GPIO_PIN_RESET);  // Đèn vàng sáng (Active Low)
            }

            // Hiển thị chế độ "03" trên LED 7-segment (đường A)
            led_buffer[0] = 0;  // "0"
            led_buffer[1] = 3;  // "3"
            display7SEG(led_buffer[0]);  // Hiển thị "0" trên LED 7-segment

            // Hiển thị thời gian còn lại cho đèn vàng
            led_buffer[2] = (time_yellow / 10) % 10;  // Hiển thị thời gian cho đèn vàng
            led_buffer[3] = time_yellow % 10;

            // Cập nhật LED 7-segment
            update7SEG(0);  // Đường A
            update7SEG(1);  // Đường B

            // Chuyển sang Mode 4 khi nút MODE (button 0) nhấn
            if (isbuttonpressed(0) || isbuttonlongpressed(0)) {
                mode = 4;  // Chuyển sang chế độ chỉnh sửa thời gian cho đèn xanh (Mode 4)
            }
            break;

        case 4:  // Mode 4: Chỉnh thời gian cho đèn xanh
            // Nháy LED xanh
            if (blink_flag) {
                HAL_GPIO_TogglePin(LED_GREEN_B_GPIO_Port, LED_GREEN_B_Pin);  // Nháy LED xanh
            } else {
                HAL_GPIO_WritePin(LED_GREEN_B_GPIO_Port, LED_GREEN_B_Pin, GPIO_PIN_RESET);  // Đèn xanh sáng (Active Low)
            }

            // Hiển thị chế độ "04" trên LED 7-segment (đường A)
            led_buffer[0] = 0;  // "0"
            led_buffer[1] = 4;  // "4"
            display7SEG(led_buffer[0]);  // Hiển thị "0" trên LED 7-segment

            // Hiển thị thời gian còn lại cho đèn xanh
            led_buffer[2] = (time_green / 10) % 10;  // Hiển thị thời gian cho đèn xanh
            led_buffer[3] = time_green % 10;

            // Cập nhật LED 7-segment
            update7SEG(0);  // Đường A
            update7SEG(1);  // Đường B

            // Chuyển sang Mode 1 khi nút MODE (button 0) nhấn
            if (isbuttonpressed(0) || isbuttonlongpressed(0)) {
                mode = 1;  // Quay lại chế độ bình thường (Mode 1)
            }
            break;

        default:
            mode = 1;  // Quay về chế độ mặc định Mode 1
            break;
    }
}
