#include "automatic.h"

int counter0 = 0;  // Đếm thời gian cho đèn đỏ đường A
int counter1 = 0;  // Đếm thời gian cho đèn xanh đường A
int counter2 = 0;  // Đếm thời gian cho đèn đỏ đường B
int counter3 = 0;  // Đếm thời gian cho đèn xanh đường B

int time_red = 6;    // Thời gian đèn đỏ (6 giây)
int time_green = 4;  // Thời gian đèn xanh (4 giây)
int time_yellow = 2; // Thời gian đèn vàng (2 giây)

void fsm_automatic_run() {
    switch (status) {
        case INIT:
            // Khởi tạo: Tắt tất cả các LED và thiết lập thời gian cho các đèn
            turnoffled();  // Hàm tắt tất cả các LED
            counter0 = time_red;  // Đặt thời gian đèn đỏ cho đường A
            counter1 = time_green;  // Đặt thời gian đèn xanh cho đường A
            counter2 = time_red;  // Đặt thời gian đèn đỏ cho đường B
            counter3 = time_green;  // Đặt thời gian đèn xanh cho đường B
            status = AUTO_RED_GREEN;  // Chuyển sang chế độ AUTO_RED_GREEN
            setTimer(1, time_red * 1000);  // Đặt timer cho đèn đỏ đường A
            setTimer(3, time_red * 1000);  // Đặt timer cho đèn đỏ đường B
            break;

        case AUTO_RED_GREEN:
            // Chế độ đèn đỏ đường A và đèn xanh đường B sáng
            setred(0);  // Đèn đỏ đường A sáng
            setgreen(1);  // Đèn xanh đường B sáng
            setyellow(0);  // Đèn vàng tắt

            if (isTimerExpired(1)) {
                counter0--;  // Giảm thời gian đèn đỏ đường A
                counter3--;  // Giảm thời gian đèn xanh đường B
                updateLEDBuffer(counter0, counter3);  // Cập nhật LED 7-segment

                setTimer(1, 1000);  // Đặt lại timer cho đèn đỏ đường A
                setTimer(3, 1000);  // Đặt lại timer cho đèn xanh đường B
            }

            // Sau khi đếm hết thời gian đèn đỏ và đèn xanh, chuyển sang chế độ AUTO_YELLOW
            if (isTimerExpired(1)) {
                setyellow(1);  // Đèn vàng sáng trên cả hai đường
                setTimer(2, time_yellow * 1000);  // Đặt timer cho đèn vàng
                status = AUTO_YELLOW;  // Chuyển sang chế độ AUTO_YELLOW
            }
            break;

        case AUTO_YELLOW:
            // Chế độ đèn vàng sáng trên cả hai đường
            setred(0);  // Đèn đỏ tắt
            setgreen(0);  // Đèn xanh tắt
            setyellow(1);  // Đèn vàng sáng

            // Sau khi đếm hết thời gian đèn vàng, chuyển sang chế độ AUTO_GREEN_RED
            if (isTimerExpired(2)) {
                setTimer(3, time_green * 1000);  // Đặt timer cho đèn xanh đường B
                setTimer(1, time_green * 1000);  // Đặt timer cho đèn xanh đường A
                status = AUTO_GREEN_RED;  // Chuyển sang chế độ AUTO_GREEN_RED
            }
            break;

        case AUTO_GREEN_RED:
            // Chế độ đèn xanh đường A và đèn đỏ đường B sáng
            setred(1);  // Đèn đỏ đường A sáng
            setgreen(0);  // Đèn xanh đường A sáng
            setyellow(0);  // Đèn vàng tắt

            setred(0);  // Đèn đỏ đường B tắt
            setgreen(1);  // Đèn xanh đường B sáng
            setyellow(0);  // Đèn vàng tắt

            // Sau khi đếm hết thời gian đèn xanh và đèn đỏ, quay lại chế độ AUTO_RED_GREEN
            if (isTimerExpired(3)) {
                setTimer(1, time_red * 1000);  // Đặt lại timer cho đèn đỏ đường A
                setTimer(3, time_red * 1000);  // Đặt lại timer cho đèn đỏ đường B
                status = AUTO_RED_GREEN;  // Quay lại chế độ AUTO_RED_GREEN
            }
            break;

        default:
            status = AUTO_RED_GREEN;  // Quay lại chế độ AUTO_RED_GREEN nếu có lỗi
            break;
    }
}
